    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/unist": "^3.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "tailwindcss": "^4",
    "tsx": "^4.22.3",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@vercel/og": {
      "sharp": "^0.35.4"
    }
  },
  "pnpm": {
    "overrides": {
      "@vercel/og>sharp": "^0.35.4"
    }
  }
