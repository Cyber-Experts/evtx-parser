  },
  "lint-staged": {
    "content/**/*.{md,mdx}": "tsx scripts/lint-content.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@formatjs/intl-localematcher": "^0.8.8",
    "@next-md-blog/core": "^1.3.0",
    "@shikijs/rehype": "^4.1.0",
    "@tailwindcss/typography": "^0.5.19",
    "@vercel/analytics": "^2.0.1",
    "@vercel/og": "^0.11.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "gray-matter": "^4.0.3",
    "image-size": "^2.0.4",
    "lucide-react": "^1.16.0",
    "negotiator": "^1.0.0",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.13.3",
